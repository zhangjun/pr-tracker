# ── OpenAI-compatible LLM endpoint ────────────────────────────────────────────
# Used by:  python collect.py --llm  |  python llm_enrich.py
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
#
# Any OpenAI-compatible server works: OpenAI, Azure OpenAI, vLLM, SGLang,
# Ollama, LM Studio, DeepSeek, Moonshot, Qwen, OpenRouter, etc.

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Examples for common backends ──────────────────────────────────────────────
# OpenAI (default)
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
#
# DeepSeek
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   OPENAI_MODEL=deepseek-chat
#
# Ollama (local)
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=llama3.1
#
# vLLM / SGLang server (local)
#   OPENAI_BASE_URL=http://localhost:8000/v1
#   OPENAI_API_KEY=none
#   OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# LM Studio (local)
#   OPENAI_BASE_URL=http://localhost:1234/v1
#   OPENAI_API_KEY=lm-studio
#   OPENAI_MODEL=local-model
